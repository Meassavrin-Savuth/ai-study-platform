# =====================
# Environment Variables — NEVER commit these
# =====================
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.*

# =====================
# Go (Backend)
# =====================
backend/tmp/
backend/bin/
# Go binary output (if you run `go build`)
backend/ai-study-platform
backend/*.exe

# =====================
# Node / Next.js (Frontend)
# =====================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/coverage/
frontend/*.tsbuildinfo
# next-env.d.ts is auto-generated by Next.js
frontend/next-env.d.ts

# =====================
# Python (Scripts)
# =====================
__pycache__/
*.pyc
*.pyo
*.pyd
backend/scripts/__pycache__/

# =====================
# macOS
# =====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# =====================
# Editor / IDE
# =====================
.vscode/
.idea/
*.swp
*.swo

# =====================
# Logs
# =====================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
